          },
          "institution": {
            "type": "string"
          },
          "account_type": {
            "type": "string"
          },
          "period_start": {
            "type": "string"
          },
          "period_end": {
            "type": "string"
          },
          "days_covered": {
            "type": "integer"
          },
          "days_old": {
            "type": "integer"
          },
          "source_file": {
            "type": "string"
          },
          "credit_limit": {
            "type": "number"
          },
          "opening_balance": {
            "type": "number"
          },
          "closing_balance": {
            "type": "number"
          },
