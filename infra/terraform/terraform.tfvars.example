# ===========================
# Kiwi Knowledge Bill OCR - Terraform Variables
# ===========================
# Copy this file to terraform.tfvars and customize for your environment
# NEVER commit terraform.tfvars with real values to source control

# ===========================
# Project Configuration
# ===========================

# subscription_id = ""  # Optional: Azure subscription ID (deploy.ps1 auto-exports ARM_SUBSCRIPTION_ID)
project_name   = "kiwi-ocr"
unique_suffix  = ""  # Leave empty to generate random suffix, or provide 4-8 char string
environment    = "dev"
location       = "australiaeast"  # australiaeast, eastus2, westeurope, etc.

# ===========================
# Resource Group
# ===========================

# Set to true to use an existing resource group instead of creating new
use_existing_resource_group = false
# resource_group_name = "existing-rg-name"  # Required if use_existing_resource_group = true

# ===========================
# Storage Account
# ===========================

storage_account_tier     = "Standard"  # Standard or Premium
storage_replication_type = "LRS"       # LRS, GRS, RAGRS, ZRS, GZRS, RAGZRS
storage_containers       = ["vikas-samples"]  # Input container(s) for EXTRACT_ALLOWED_BINDERS

# Optional: Override default container names used by Function App
# batches_container_override = "custom-batches"  # Default: vikas-batches
# reports_container_override = "custom-reports"  # Default: vikas-reports

# ===========================
# Document Intelligence
# ===========================

document_intelligence_sku = "S0"  # F0 (free tier) or S0 (standard)

# ===========================
# App Service Plan & Function App
# ===========================

app_service_plan_sku = "B1"  # B1, B2, B3, S1-S3, P1v2-P3v3 (Linux plans)

# Use managed identity for Document Intelligence access (recommended for production)
use_managed_identity = false  # Set to true to use managed identity instead of API keys

# ===========================
# Azure AI Foundry (Preview)
# ===========================

# WARNING: AI Foundry Hub/Project creation is in preview
# Agent and OpenAPI tool attachments cannot be automated via Terraform
# and must be configured manually in the Azure AI Portal

# Both create flags default true: one-click -Action all builds Foundry, not just Function/DI.
create_ai_foundry_resources = true   # Key Vault / App Insights / optional classic OpenAI
create_classic_foundry_hub  = false  # classic Hub is not visible in the new Foundry portal

# Nextgen Microsoft Foundry (Azure Foundry list + ai.azure.com/nextgen)
create_foundry_aiservices             = true
foundry_aiservices_sku                = "Standard"
foundry_aiservices_model_version      = "2024-11-20"
foundry_aiservices_model_capacity     = 10

# Classic OpenAI account (only if create_ai_foundry_resources = true). Empty skips that account.
# Common models: gpt-4, gpt-35-turbo, gpt-4o, gpt-4-turbo
foundry_model_name       = ""       # e.g., "gpt-4o" - leave empty to skip classic model deployment
foundry_model_version    = "2024-05-13"  # Version depends on model (gpt-4o: 2024-05-13, gpt-4: 0613)
foundry_deployment_name  = "gpt-4o"      # Should match model name for consistency
foundry_model_capacity   = 10            # TPM in thousands

# ===========================
# Tags
# ===========================

tags = {
  Owner       = "platform-team"
  CostCenter  = "engineering"
  Application = "kiwi-knowledge-bill-ocr"
}
