# Merchant memory contains reusable public outflow brands only. The builder
# strips applicant-specific data, so the safe result is committed and deployed
# from the same Git revision; confirmed agent-recognisable brands can be pruned.

# Material received from Vikas, not ours to publish in a public repo.
from vikas/

# Personal notes and analysis files with real human names / applicant PII must not be committed.
VIKAS-ATTACHMENTS-ANALYSIS.md

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

